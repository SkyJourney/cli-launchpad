{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CLI Launchpad",
  "version": "0.3.0",
  "identifier": "app.cli-launchpad.desktop",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CLI Launchpad",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "publisher": "SkyJourney",
    "copyright": "Copyright © 2026 SkyJourney",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

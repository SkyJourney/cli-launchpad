{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CLI Launchpad",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": true,
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 20
        }
      }
    ]
  },
  "bundle": {
    "targets": ["dmg"]
  }
}

{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "terminal-window",
  "description": "独立终端窗口所需的终端、事件和窗口关闭能力。",
  "windows": ["terminal-*"],
  "permissions": [
    "core:event:allow-emit-to",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-is-maximized",
    "core:window:allow-minimize",
    "core:window:allow-set-theme",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-toggle-maximize",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "allow-begin-pty-handoff",
    "allow-stage-pty-handoff-snapshot",
    "allow-complete-pty-handoff",
    "allow-finalize-pty-handoff",
    "allow-cancel-pty-handoff",
    "allow-get-pty-session-window-status",
    "allow-write-pty-session",
    "allow-resize-pty-session",
    "allow-acknowledge-pty-output",
    "allow-report-pty-frontend-stage",
    "allow-terminate-pty-session"
  ]
}

{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口默认能力：核心 API 与应用命令。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-is-maximized",
    "core:window:allow-minimize",
    "core:window:allow-set-focus",
    "core:window:allow-set-theme",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-toggle-maximize",
    "dialog:allow-open",
    "dialog:allow-save",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/SkyJourney/cli-launchpad"
        }
      ]
    },
    "allow-list-backups",
    "allow-create-backup",
    "allow-restore-backup",
    "allow-get-cache-stats",
    "allow-clear-cache",
    "allow-export-diagnostics-to-path",
    "allow-list-launch-history",
    "allow-clear-launch-history",
    "allow-get-launch-history-limit",
    "allow-set-launch-history-limit",
    "allow-list-sessions",
    "allow-search-sessions",
    "allow-refresh-session-search-index",
    "allow-set-session-alias",
    "allow-delete-session-alias",
    "allow-create-pty-session",
    "allow-begin-pty-handoff",
    "allow-stage-pty-handoff-snapshot",
    "allow-complete-pty-handoff",
    "allow-finalize-pty-handoff",
    "allow-cancel-pty-handoff",
    "allow-get-pty-session-window-status",
    "allow-reattach-pty-session",
    "allow-write-pty-session",
    "allow-resize-pty-session",
    "allow-acknowledge-pty-output",
    "allow-report-pty-frontend-stage",
    "allow-terminate-pty-session",
    "allow-confirm-app-exit",
    "allow-list-directories",
    "allow-add-directory",
    "allow-update-directory",
    "allow-remove-directory",
    "allow-set-directory-pinned",
    "allow-reorder-directories",
    "allow-open-project-directory",
    "allow-list-project-files",
    "allow-open-project-file",
    "allow-save-project-text-file",
    "allow-start-execution-task",
    "allow-list-execution-tasks",
    "allow-get-execution-task",
    "allow-cancel-execution-task",
    "allow-clear-execution-task",
    "allow-clear-execution-history",
    "allow-detect-cli-status",
    "allow-fetch-latest-version",
    "allow-get-install-plan",
    "allow-export-config-to-path",
    "allow-import-config-from-path",
    "allow-get-close-behavior",
    "allow-set-close-behavior",
    "allow-get-workspace-layout",
    "allow-save-workspace-layout",
    "allow-reset-workspace-layout",
    "allow-list-workspace-layout-presets",
    "allow-create-workspace-layout-preset",
    "allow-update-workspace-layout-preset",
    "allow-rename-workspace-layout-preset",
    "allow-delete-workspace-layout-preset",
    "allow-plan-apply-workspace-layout-preset"
  ]
}

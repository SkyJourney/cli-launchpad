{
  "name": "cli-launchpad",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:windows": "tauri build --bundles nsis",
    "tauri:build:offline": "tauri build --config src-tauri/tauri.offline.conf.json",
    "tauri:build:macos": "tauri build --bundles dmg",
    "tauri:build:macos:arm64": "tauri build --bundles dmg --target aarch64-apple-darwin",
    "tauri:build:macos:x64": "tauri build --bundles dmg --target x86_64-apple-darwin",
    "build:installers": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-installers.ps1",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@lobehub/icons": "^5.8.0",
    "@tanstack/react-query": "^5.0.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}

  "version": 1,
  "cases": [
    {
      "name": "insensitive-same-identity-merges-into-first-seen",
      "semantics": {
        "1": {
          "case": "insensitive",
          "normalizationInsensitive": "no"
        }
      },
      "documents": [
        {
          "id": "d1",
          "directoryId": 1,
          "relativePath": "a.txt"
        },
        {
          "id": "d2",
          "directoryId": 1,
          "relativePath": "A.txt"
        }
      ],
      "panes": [
        {
          "id": "p1",
          "contents": ["d1"],
          "active": "d1"
        },
        {
          "id": "p2",
          "contents": ["d2"],
          "active": "d2"
        }
      ],
      "detached": [],
      "fileIdentity": {
        "a.txt|A.txt": "same"
      },
      "expected": {
        "documents": ["d1"],
        "panes": [
          {
            "id": "p1",
            "contents": ["d1"],
            "active": "d1"
          },
          {
            "id": "p2",
            "contents": [],
            "active": null
          }
        ],
        "detached": [],
        "merged": [
          {
            "canonical": "d1",
            "variants": ["d2"]
          }
        ]
      }
    },
